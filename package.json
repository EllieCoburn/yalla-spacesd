{
  "name": "yalla-sd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.mts && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/seed.mts",
    "admin:create": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/create-admin.mts",
    "jobs:run": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/jobs.mts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
