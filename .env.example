# See docs/ADMIN.md for what each variable does. Never commit real values.

# Database (Postgres). On Vercel, add Neon from the Marketplace.
DATABASE_URL=
# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=
# One-time secret for /admin/setup (remove after creating the first owner)
ADMIN_SETUP_TOKEN=
PUBLIC_BASE_URL=



# Background jobs
CRON_SECRET=

# Email — test mode captures messages instead of sending them
NOTIFICATIONS_MODE=test
RESEND_API_KEY=
NOTIFICATIONS_FROM=

# Payments — without Stripe keys the built-in test sandbox is used
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Must be "true" before a live (sk_live_) key will be used
PAYMENTS_LIVE_ENABLED=false

# Tests (database name must contain "test")
TEST_DATABASE_URL=
