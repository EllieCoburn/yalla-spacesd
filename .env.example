# See docs/ADMIN.md for what each variable does. Never commit real values.

# Database (Postgres). On Vercel, add Neon from the Marketplace.
DATABASE_URL=
# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=
# One-time secret for /admin/setup (remove after creating the first owner)
ADMIN_SETUP_TOKEN=
# The site address used in every emailed and redirect link (e.g. https://www.yallaspacesd.com).
# Set it in Production. Links are never built from the incoming request on Vercel.
PUBLIC_BASE_URL=



# Background jobs
CRON_SECRET=

# Email — test mode captures messages instead of sending them
NOTIFICATIONS_MODE=test
POSTMARK_SERVER_TOKEN=
NOTIFICATIONS_FROM=

# Payments — without Stripe keys the built-in test sandbox is used
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Must be "true" before a live (sk_live_) key will be used
PAYMENTS_LIVE_ENABLED=false
# The built-in test checkout ("pay" without money moving). Off on every Vercel deployment unless
# this is "true"; only set it on a preview that uses a test database with fictional data.
ALLOW_TEST_PAYMENTS=

# Tests (database name must contain "test")
TEST_DATABASE_URL=
